# CC Currency Converter — backend environment
# Copy to `.env` and fill in your values.

# Port the API listens on
PORT=3000

# Upstream exchange-rate API (base currency = USD)
UPSTREAM_URL=https://open.er-api.com/v6/latest/USD

# Admin dashboard credentials (fallback when Supabase is unavailable)
ADMIN_USER=mentos
ADMIN_PASS=mentos321

# Secret used to sign admin tokens (set a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key